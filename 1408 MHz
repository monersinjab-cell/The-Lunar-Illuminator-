        "reference": "البقرة 2:61",
    },
]

SATELLITES = [
    "SAT-01",
    "SAT-02",
    "SAT-03",
    "SAT-04",
    "SAT-05",
    "SAT-06",
    "SAT-07",
    "SAT-08",
    "SAT-09",
    "SAT-10",
    "SAT-11",
    "SAT-12",
]


def create_rf_simulation():
    records = []

    for satellite in SATELLITES:
        for item in QURAN_TEXTS:

            records.append({
                "timestamp": datetime.now().isoformat(),
                "satellite_id": satellite,
                "mode": MODE,
                "status": STATUS,
                "frequency_mhz": None,
                "power_watts": None,
                "transmission": False,
                "simulation": True,
                "quran_reference": item["reference"],
                "text": item["text"],
                "note": (
                    "محاكاة بيانات فقط؛ "
                    "لا يوجد بث RF أو إرسال فضائي حقيقي."
                ),
            })

    return records


def save_status(records):
    data = {
        "project": PROJECT,
        "status": STATUS,
        "created_at": datetime.now().isoformat(),
        "satellites": len(SATELLITES),
        "texts": len(QURAN_TEXTS),
        "records": len(records),
        "rf_transmission": False,
        "records_data": records,
    }

    with open(
        "RF_STATUS.json",
        "w",
        encoding="utf-8"
    ) as file:
        json.dump(
            data,
            file,
            ensure_ascii=False,
            indent=4
        )


def main():
    records = create_rf_simulation()
    save_status(records)

    print("=" * 60)
    print(PROJECT)
    print("RF SATELLITE SIMULATION")
    print("=" * 60)
    print("الحالة: SIMULATION_ONLY")
    print("الإرسال الحقيقي: غير مفعل")
    print("الأقمار الافتراضية:", len(SATELLITES))
    print("النصوص:", len(QURAN_TEXTS))
    print("السجلات:", len(records))
    print("تم إنشاء: RF_STATUS.json")


if __name__ == "__main__":
    main()


