# -*- coding: utf-8 -*-

import json
from datetime import datetime

PROJECT = "قمرا منيرا باذن ربه"
MODE = "RF Simulation"
STATUS = "SIMULATION_ONLY"

QURAN_TEXTS = [
    {
        "id": 1,
        "text": "وعلامات وبالنجم هم يهتدون",
        "reference": "النحل 16:16",
    },
    {
        "id": 2,
        "text": "فما ظنكم برب العالمين",
        "reference": "الصافات 37:87",
    },
    {
        "id": 3,
        "text": "ويخلق ما لا تعلمون",
        "reference": "النحل 16:8",
    },
    {
        "id": 4,
        "text": "يتجرعه ولا يكاد يسيغه ويأتيه الموت من كل مكان وما هو بميت ومن ورائه عذاب غليظ",
        "reference": "إبراهيم 14:17",
    },
    {
        "id": 5,
        "text": "الا تنصروه فقد نصره الله",
