import json
from pathlib import Path

CONFIG = Path("munir_general_alert.json")


def load_config():
    with CONFIG.open("r", encoding="utf-8") as f:
        return json.load(f)


def announce(config):
    announcement = config["announcement"]

    print("=" * 60)
    print(announcement["title"])
    print("=" * 60)
    print(announcement["text"])
    print()


def show_quran_references(config):
    print("المراجع القرآنية")
    print("-" * 60)

    for item in config["quran_references"]:
        print(f'{item["reference"]}:')
        print(item["text"])
        print()


def safety_check(config):
    safety = config["safety"]

    forbidden = [
        "violent_mobilization",
        "military_command",
        "targeting_people",
        "targeting_devices",
        "harmful_actions",
        "quran_as_command_generator"
    ]

    return not any(safety.get(key, False) for key in forbidden)


def main():
    config = load_config()

    if not safety_check(config):
        raise RuntimeError("تم إيقاف المحاكاة بسبب إعداد غير آمن.")

    announce(config)
    show_quran_references(config)

    print("=" * 60)
    print("حالة النظام: بحث ومحاكاة غير تنفيذية")
    print("لا توجد أوامر عسكرية أو استهداف أو إيذاء.")
    print("=" * 60)


if __name__ == "__main__":
    main()
