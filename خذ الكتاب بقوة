# -*- coding: utf-8 -*-
"""تحليل رقمي ورمزي للنص:
ولا يحيق المكر السيئ إلا بأهله
المرجع القرآني: فاطر 43 (35:43)

ملاحظة: الأرقام الناتجة تمثيلات حسابية/ترميزية فقط،
ولا تثبت دلالة غيبية أو إعجازا عدديا.
"""

import unicodedata

TEXT = 'ولا يحيق المكر السيئ إلا بأهله'
WORDS = TEXT.split()

ABJAD = {'ا': 1, 'أ': 1, 'إ': 1, 'آ': 1, 'ٱ': 1, 'ب': 2, 'ج': 3, 'د': 4, 'ه': 5, 'و': 6, 'ز': 7, 'ح': 8, 'ط': 9, 'ي': 10, 'ى': 10, 'ك': 20, 'ل': 30, 'م': 40, 'ن': 50, 'س': 60, 'ع': 70, 'ف': 80, 'ص': 90, 'ق': 100, 'ر': 200, 'ش': 300, 'ت': 400, 'ث': 500, 'خ': 600, 'ذ': 700, 'ض': 800, 'ظ': 900, 'غ': 1000}

def clean_letters(s):
    return "".join(ch for ch in s if ch.isalpha())

def analyze_word(word):
    letters = clean_letters(word)
    chars = []
    total = 0
    for ch in letters:
        value = ABJAD.get(ch, 0)
        total += value
        chars.append({
            "char": ch,
            "unicode": f"U+{ord(ch):04X}",
            "decimal": ord(ch),
            "hex": f"{ord(ch):02X}",
            "binary": format(ord(ch), "016b"),
            "name": unicodedata.name(ch, "UNKNOWN"),
            "abjad": value,
        })
    return {
        "word": word,
        "letters": len(letters),
        "abjad_total": total,
        "characters": chars,
    }

def main():
    letters = clean_letters(TEXT)
    print("المرجع: فاطر 43 (35:43)")
    print("النص:", TEXT)
    print("عدد الكلمات:", len(WORDS))
    print("عدد الحروف:", len(letters))
    print("قيمة أبجد الكلية:", sum(ABJAD.get(ch, 0) for ch in letters))
    print()
    for item in map(analyze_word, WORDS):
        print(item["word"], "| حروف:", item["letters"], "| أبجد:", item["abjad_total"])
        for c in item["characters"]:
            print(" ", c)

if __name__ == "__main__":
    main()

