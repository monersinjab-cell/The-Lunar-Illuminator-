#!/usr/bin/env python3
import json
import hashlib
from pathlib import Path

JSON_FILE = Path(__file__).with_name("AL_MILYAR_UNICODE.json")

def load_data():
    with JSON_FILE.open("r", encoding="utf-8") as f:
        return json.load(f)

def sha256_text(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()

def build_index(data):
    index = {}
    for script, chars in data["letters"].items():
        index[script] = {
            "count": len(chars),
            "characters": list(chars),
            "codepoints": [f"U+{ord(c):04X}" for c in chars]
        }
    return index

def main():
    data = load_data()
    index = build_index(data)

    print("=" * 60)
    print("AL_MILYAR — Unicode Symbolic Collection")
    print("=" * 60)
    print("Identifier:", data["al_milyar"]["identifier"])
    print("Value:", data["al_milyar"]["value"])
    print()

    print("LETTER SCRIPTS:", len(data["letters"]))
    for name, info in index.items():
        print(f"{name}: {info['count']} symbols")

    print("\nNUMERAL SYSTEMS:", len(data["numerals"]))
    for name, chars in data["numerals"].items():
        print(f"{name}: {chars}")

    print("\nSYMBOLS:")
    for name, chars in data["symbols"].items():
        print(f"{name}: {chars}")

    serialized = json.dumps(
        data, ensure_ascii=False, sort_keys=True
    )
    print("\nINTEGRITY SHA-256:")
    print(sha256_text(serialized))

    output = Path(__file__).with_name("AL_MILYAR_INDEX.json")
    with output.open("w", encoding="utf-8") as f:
        json.dump(index, f, ensure_ascii=False, indent=2)

    print("\nCreated:", output.name)

if __name__ == "__main__":
    main()
