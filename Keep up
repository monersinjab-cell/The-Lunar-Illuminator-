import json
import unicodedata
from datetime import datetime, timezone

RAW_TEXT = """استعذ بالله من الشيطان الرجيم 
يريدون ان يطفؤوا نور الله باافواههم ويأبى الله الا ان يتم نوره ولو كره الكافرون 

استذع بالله من الشيطان الرجيم 
هو الذي ارسل رسوله بالهدى ودين الحق ليظهره على٠ الدين كله ولو كره المشركون  

استعذ بالله من الشيطان الرجيم 
اليس الله بكاف عبده 

استعذ بالله ٠من الشيطان لرجيم٠
ان الله يدافع عن الذين آمنوا 
ان الله لايحب كل خوان كفور 

استعش بالله من الشيطان الرجيم 
اذن للذين يقاتلون باانهم ظلموا
وان الله على نصرهم اذا يشاء قدير 

وهو على كل شيئ قدير 

استعذ بالله من الشيطان الرجيم 
ويخلق مالاتعلمون"""

def character_record(char, index):
    return {
        "index": index,
        "character": char,
        "codepoint": f"U+{ord(char):04X}",
        "unicode_name": unicodedata.name(char, "UNKNOWN"),
        "category": unicodedata.category(char),
        "combining_class": unicodedata.combining(char),
        "is_digit": char.isdigit(),
        "is_letter": char.isalpha(),
        "is_whitespace": char.isspace(),
        "is_punctuation": unicodedata.category(char).startswith("P"),
        "is_mark": unicodedata.category(char).startswith("M")
    }

characters = [
    character_record(char, i)
    for i, char in enumerate(RAW_TEXT)
]

project = {
    "project": "قمرا منيرا باذن ربه",
    "version": "1.0",
    "purpose": [
        "preserve_input",
        "unicode_analysis",
