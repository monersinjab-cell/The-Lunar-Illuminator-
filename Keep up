        "no_unauthorized_access": True,
        "no_control_of_people_or_systems": True
    },

    "coverage_concept": {
        "space": True,
        "ground": True,
        "underground": True,
        "underwater": True,
        "digital_systems": True,
        "meaning": "مراقبة وسلامة ووعي فقط، وليس بثا مؤذيا أو تحكما خفيا"
    },

    "input": {
        "encoding": "UTF-8",
        "raw_text_preserved": True,
        "text": RAW_TEXT
    },

    "unicode": {
        "character_count": len(RAW_TEXT),
