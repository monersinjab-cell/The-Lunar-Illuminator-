import json, random, hashlib
from datetime import datetime, timezone
from pathlib import Path

BASE = Path(__file__).parent
CONFIG = BASE / "AL_MILYAR.json"

def load():
    return json.loads(CONFIG.read_text(encoding="utf-8"))

def billion_code(text):
    return [{"char": c, "unicode": f"U+{ord(c):04X}", "billion": ord(c)*1_000_000_000} for c in text]

def synthetic_numbers(n=32):
    return [random.randint(0, 999_999_999) for _ in range(n)]

def synthetic_symbols(n=32):
    pool = "☾☀★☆✦✧∞≈≠≤≥±×÷∑√∫-_.:;|/+=*~"
    return [random.choice(pool) for _ in range(n)]

def hash_data(data):
    raw = json.dumps(data, ensure_ascii=False, sort_keys=True).encode()
    return hashlib.sha256(raw).hexdigest()

def run():
    cfg = load()
    result = {
        "project": cfg["project"],
        "identifier": cfg["identifier"],
        "leadership_label": cfg["leadership_label"],
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "billion_encoding": billion_code("moner"),
        "numbers": synthetic_numbers(),
        "symbols": synthetic_symbols(),
        "simulation": cfg["simulation"],
        "safety": cfg["safety"]
    }
    result["integrity_hash"] = hash_data(result)
    return result

if __name__ == "__main__":
    result = run()
    print("AL MILYAR")
    print("المليار منير نذير — القائد الأعلى (تسمية المشروع)")
    print("المعرّف:", result["identifier"])
    print("الحالة: محاكاة محلية")
    print("بصمة السلامة:", result["integrity_hash"])

